# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# LaTeX build artifacts (regenerated by paper/build.sh; may embed local
# TinyTeX install paths, so keep them out of version control)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz

# Journal revision materials: referee report, response letter, drafts (confidential; repo is public)
paper/revision-R1/
paper/title_page.tex
paper/title_page*.pdf
